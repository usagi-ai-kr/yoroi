# Yoroi 환경 변수 템플릿 (값 없음)
# 복사해서 값을 채운 뒤 `.env`로 저장하세요. `.env`는 Git에 커밋하지 않으며
# 이 파일(.env.example)만 .gitignore 예외로 추적됩니다.
# 실행 시 현재 디렉터리 .env와 설치 위치 복사본을 모두 읽어 키 단위로 적용합니다(환경 변수 > 현재 디렉터리 .env > 설치 복사본).

# [선택] 조회할 공급자 ID(쉼표 구분). 생략하면 다섯 개 전체
# YOROI_PROVIDERS=

# [선택] 전체 timeout ms(기본 10000). 공급자별: YOROI_<공급자>_TIMEOUT_MS
# YOROI_TIMEOUT_MS=
# [선택] watch 간격 초(기본 60, 1–86400)
# YOROI_INTERVAL_SECONDS=
# [선택] 1이면 읽은 .env 경로만 stderr에 표시(값 미출력)
# YOROI_DEBUG=

# [선택] 로컬 CLI 실행 파일 경로(기본 PATH 탐색). 같은 패턴의 공급자별 timeout도 사용 가능
# YOROI_CODEX_PATH=
# YOROI_AGY_PATH=

# [필수: opencode-go 선택 시] OpenCode Go API key
# YOROI_OPENCODE_GO_API_KEY=

# [선택] Ollama Pro Ed25519 서명 키 경로(기본 $HOME/.ollama/id_ed25519)
# YOROI_OLLAMA_PRO_SIGNING_KEY_PATH=

# [선택] Claude OAuth 토큰(우선순위: YOROI_CLAUDE_OAUTH_TOKEN → CLAUDE_CODE_OAUTH_TOKEN → 저장 프로필)
# YOROI_CLAUDE_OAUTH_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN=
# [선택] Claude 프로필 위치(기본 HOME/.claude)
# CLAUDE_CONFIG_DIR=
# CLAUDE_SECURESTORAGE_CONFIG_DIR=
