{
  "name": "yoroi",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "pnpm@12.10.1",
  "bin": {
    "yoroi": "dist/src/main.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./tests/harness-setup.mjs --import tsx --test \"tests/**/*.test.ts\"",
    "test:bdd": "node --import ./tests/harness-setup.mjs --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:bdd && pnpm run build",
    "install:global": "node scripts/install-global.mjs",
    "update:global": "node scripts/update-global.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "cli-table3": "0.6.5",
    "ky": "2.2.0",
    "picocolors": "1.1.1"
  }
}
